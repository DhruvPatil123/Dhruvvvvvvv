# =============================================================================
# ENVIRONMENT VARIABLES FOR LOCAL DEV & VERCEL DEPLOYMENT
# =============================================================================

# GEMINI_API_KEY (Optional for preview, recommended for live AI chat):
# Provides the server-side API key for Google Gemini model generation in the chatbot.
# On Vercel: Set under Project Settings > Environment Variables.
# If omitted, the chatbot gracefully uses Dhruv's pre-computed portfolio knowledge base.
GEMINI_API_KEY=""

# RESEND_API_KEY (Optional):
# API Key from https://resend.com for sending real emails from the Contact Form.
# If left empty, the contact form simulates successful submissions gracefully in logs.
RESEND_API_KEY=""

# RESEND_FROM_EMAIL (Optional):
# Verified sender email address configured in Resend (e.g., 'Portfolio Contact <onboarding@resend.dev>')
RESEND_FROM_EMAIL=""

# CONTACT_TO_EMAIL (Optional):
# Destination inbox for messages sent through the contact form. Defaults to sujalpatil8657231278@gmail.com
CONTACT_TO_EMAIL=""
